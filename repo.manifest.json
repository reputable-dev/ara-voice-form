{
    "repo": "ara-voice-form",
    "branch": "main",
    "packageManagers": ["bun"],
    "node": "20.x",
    "workspaces": [],
    "rootScripts": {
        "start": "expo start",
        "start-web": "expo start --web",
        "dev": "bun run convex:dev",
        "convex:dev": "convex dev",
        "build": "expo export --platform web",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "lint": "expo lint",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "convex:deploy": "convex deploy"
    },
    "envExamplePaths": [".env.example"],
    "ciPipelines": ["./.github/workflows/*.yml"],
    "cloudTargets": ["Convex", "Railway", "Expo EAS"],
    "framework": "React Native + Expo SDK 54",
    "backend": "Convex (migrated from tRPC/Hono)",
    "ai": "OpenRouter + ElevenLabs",
    "testing": "Jest + React Testing Library",
