# ARA Voice Form - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ====================================
# Required Environment Variables
# ====================================

# Convex Backend URL
# Local development: http://localhost:3210 (your Convex deployment URL)
# Production: https://your-convex-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_URL=http://localhost:3210

# OpenRouter API Key
# Get your key at: https://openrouter.ai/
# CRITICAL: Never commit actual keys to version control
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: OpenRouter referrer and title for rankings
# EXPO_PUBLIC_OPENROUTER_HTTP_REFERER=https://your-app-domain.com
# EXPO_PUBLIC_OPENROUTER_X_TITLE=Your App Name

# ElevenLabs API Key (for ScribeV2 speech-to-text)
# Get your key at: https://elevenlabs.io/app/profile
# CRITICAL: Never commit actual keys to version control
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
EXPO_PUBLIC_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google Gemini API Key (for RAG file search)
# Get your key at: https://aistudio.google.com/app/apikey
# CRITICAL: Never commit actual keys to version control
GEMINI_API_KEY=your_gemini_api_key_here

# RAG Service Configuration
# RAG service URL (default: http://localhost:5001)
RAG_SERVICE_URL=http://localhost:5001

# RAG store name (default: default_store)
RAG_STORE_NAME=default_store

# Allowed CORS origins (comma-separated)
RAG_CORS_ORIGINS=http://localhost:3000,http://localhost:5001

# Gemini model to use (default: gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-pro

# Upload timeout in seconds (default: 180)
UPLOAD_TIMEOUT=180

# Enable API documentation UI (default: true)
ENABLE_API_DOCS=true

# Sentry DSN (Data Source Name)
# Get your DSN at: https://sentry.io/
# Required for production error monitoring
# Optional in development (errors will be logged to console if not set)
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Sentry Debug Mode (optional)
# Set to "true" to send errors to Sentry even in development
# EXPO_PUBLIC_SENTRY_DEBUG=false

# ====================================
# Optional Environment Variables
# ====================================

# Rork Project ID (default: fhwpveo9srinxla5renne)
# Only change if you have a different Rork project
# RORK_PROJECT_ID=your_project_id_here

# ====================================
# Security Notes
# ====================================

# 1. NEVER commit .env files to version control
#    (.env is already in .gitignore)
#
# 2. For production builds, set environment variables in:
#    - Expo: eas.json build profiles
#    - Vercel: Project settings → Environment Variables
#    - Other platforms: Follow their env var documentation
#
# 3. Rotate API keys regularly and after any suspected exposure
#
# 4. Use different keys for development, staging, and production

# ====================================
# Development Setup
# ====================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Fill in your actual API keys in .env
#
# 3. Start Convex backend:
#    bun run convex dev
#
# 4. Restart the development server:
#    bun run start
#
# 5. Verify environment variables are loaded:
#    Check for "No API key" errors in console
