# ARA Voice Form - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ====================================
# Required Environment Variables
# ====================================

# tRPC Backend Base URL
# Local development: http://localhost:3000
# Production: https://your-api-domain.com
EXPO_PUBLIC_RORK_API_BASE_URL=http://localhost:3000

# Google Gemini API Key
# Get your key at: https://ai.google.dev/
# CRITICAL: Never commit actual keys to version control
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Sentry DSN (Data Source Name)
# Get your DSN at: https://sentry.io/
# Required for production error monitoring
# Optional in development (errors will be logged to console if not set)
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Sentry Debug Mode (optional)
# Set to "true" to send errors to Sentry even in development
# EXPO_PUBLIC_SENTRY_DEBUG=false

# ====================================
# Optional Environment Variables
# ====================================

# Rork Project ID (default: fhwpveo9srinxla5renne)
# Only change if you have a different Rork project
# RORK_PROJECT_ID=your_project_id_here

# ====================================
# Security Notes
# ====================================

# 1. NEVER commit .env files to version control
#    (.env is already in .gitignore)
#
# 2. For production builds, set environment variables in:
#    - Expo: eas.json build profiles
#    - Vercel: Project settings → Environment Variables
#    - Other platforms: Follow their env var documentation
#
# 3. Rotate API keys regularly and after any suspected exposure
#
# 4. Use different keys for development, staging, and production

# ====================================
# Development Setup
# ====================================

# 1. Copy this file:
#    cp .env.example .env
#
# 2. Fill in your actual API keys in .env
#
# 3. Restart the development server:
#    bun run start
#
# 4. Verify environment variables are loaded:
#    Check for "No API key" errors in console
